{
  "schemaVersion": 2,
  "preset": "authored-gfm@1",
  "include": ["**/*.md"],
  "exclude": [
    "**/node_modules/**",
    "types/**",
    "coverage/**",
    "artifacts/**",
    ".venv/**",
    "**/__pycache__/**",
    ".agents/**",
    ".codex/**",
    ".agent-tools/**",
    ".sdlc/runtime/**",
    ".sdlc/tmp/**"
  ],
  "lint": {},
  "links": {
    "localFiles": true,
    "rootRelative": "reject"
  },
  "layout": {
    "endOfLine": "lf",
    "tabWidth": 2
  }
}
