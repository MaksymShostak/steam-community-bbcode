{
  "name": "steam-community-bbcode",
  "version": "1.0.0-rc.1",
  "private": false,
  "description": "Steam Community BBCode package under qualification; no released converter API yet",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^22.11.0 || ^24.11.0 || ^26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || ^26.11.1",
      "onFail": "error"
    }
  },
  "packageManager": "npm@12.2.0",
  "main": "./src/index.js",
  "bin": {
    "steam-community-bbcode": "src/cli.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "coverage.json",
    "docs/third-party-notices.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "qualify:ci-selection": "node scripts/select-ci-qualification.js",
    "generate:ci-evidence": "node scripts/report-ci-evidence.js",
    "generate:release-transfer": "node scripts/stage-release-transfer.js",
    "test:ci-evidence": "node --test test/ci-evidence.test.js test/ci-qualification-selection.test.js test/release-candidate-staging.test.js test/bbcode-workflow.test.js test/release-workflow.test.js test/github-rendering.test.js",
    "qualify:node-types": "node scripts/qualify-node-declarations.js",
    "format": "prettier --write --ignore-unknown . \"!**/*.md\"",
    "check:format": "prettier --check --ignore-unknown . \"!**/*.md\"",
    "cli": "node src/cli.js",
    "compare:alternatives": "node scripts/compare-alternatives.js",
    "generate:sbom": "npm sbom --package-lock-only --offline --ignore-scripts --sbom-format=cyclonedx",
    "generate:sbom:type-coverage": "npm --prefix tooling/type-coverage sbom --package-lock-only --offline --ignore-scripts --sbom-format=cyclonedx",
    "generate:sbom:api-docs": "npm --prefix tooling/api-docs sbom --package-lock-only --offline --ignore-scripts --sbom-format=cyclonedx",
    "generate:conformance": "node scripts/generate-conformance-report.js",
    "check:conformance": "node scripts/generate-conformance-report.js --check",
    "check:docs": "node --test test/documentation.test.js",
    "generate:api-docs": "npm --prefix tooling/api-docs run generate",
    "check:api-docs": "npm --prefix tooling/api-docs run check",
    "install:markdown": "npm --prefix tooling/markdown ci --ignore-scripts --no-audit --no-fund",
    "format:markdown": "node scripts/run-markdown.mjs format",
    "check:markdown": "node scripts/run-markdown.mjs check",
    "test:markdown": "node --test tooling/markdown/integration.test.mjs scripts/check-markdown-candidate.probes.mjs",
    "test:markdown:observer": "node scripts/runRepositoryPython.js -I -B -X utf8 scripts/observe-markdown-window.probes.py",
    "test:documentation-tooling": "node --test test/set-up-development.test.js test/repository-python.test.js test/bbcode-workflow.test.js test/release-workflow.test.js test/documentation.test.js test/development-command-names.test.js scripts/set-up-development.probes.mjs",
    "lint": "eslint src scripts test tooling/api-docs/*.js eslint.config.js --max-warnings 0",
    "qualify:github": "node scripts/qualify-github-rendering.js --live",
    "qualify:performance": "node --test test/performance/*.test.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 node --test test/*.test.js test/parser-qualification/*.test.js",
    "test:mutation:library": "stryker run stryker.config.json",
    "test:mutation:cli": "stryker run stryker.cli.config.json",
    "test:mutation": "npm run test:mutation:library && npm run test:mutation:cli",
    "typecheck": "tsc --project tsconfig.json && npm run typecheck:api-docs",
    "typecheck:api-docs": "tsc --project tooling/api-docs/tsconfig.json",
    "build:types": "tsc --project tsconfig.declarations.json",
    "clean:types": "node scripts/clean-generated-types.js",
    "build": "npm run generate:spec && npm run clean:types && npm run build:types",
    "check:types": "node scripts/verify-generated-types.js",
    "test:package": "node scripts/test-package-consumers.js",
    "pack:release": "node scripts/build-release-candidate.js",
    "lint:package": "publint --strict",
    "qualify:release": "node scripts/qualify-release.js",
    "publish:bootstrap-release": "node scripts/qualify-release.js --publish",
    "verify:registry": "node scripts/qualify-public-registry.js",
    "check:type-coverage": "npm --prefix tooling/type-coverage run check && npm --prefix tooling/type-coverage run check:api-docs",
    "check:product": "npm run check:format && npm run check:spec && npm run lint && npm run check:api-docs && npm run test:coverage && npm run qualify:performance && npm run check:conformance && npm run typecheck && npm run check:type-coverage && npm run check:types && npm run test:types && npm run test:package",
    "check": "npm run check:product && npm run test:markdown && npm run test:markdown:observer && npm run check:markdown",
    "test:types": "tsc --project test/type-contracts/tsconfig.json",
    "qualify:parser": "node --test test/parser-qualification/*.test.js",
    "validate:spec": "node scripts/validate-specification.js",
    "generate:spec": "node scripts/generate-registry-modules.js",
    "check:spec": "node scripts/generate-registry-modules.js --check",
    "set-up:development": "node scripts/set-up-development.js"
  },
  "dependencies": {
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "chevrotain": "13.2.0",
    "linkify-it": "6.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-to-markdown": "2.2.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@eslint/js": ">=10.0.1",
    "@sigstore/rekor-types": ">=5.0.0",
    "@stryker-mutator/core": ">=10.0.0",
    "@stryker-mutator/tap-runner": ">=10.0.0",
    "@types/make-fetch-happen": ">=10.0.4",
    "@types/node": ">=26.6.4",
    "ajv": ">=8.20.0",
    "ajv-formats": ">=3.0.1",
    "c8": ">=12.0.0",
    "eslint": ">=10.12.0",
    "eslint-config-prettier": ">=10.1.8",
    "fast-check": ">=4.10.2",
    "globals": ">=17.13.0",
    "prettier": ">=3.9.9",
    "publint": ">=0.3.25",
    "sigstore": ">=5.0.0",
    "typescript": ">=7.0.2",
    "yaml": ">=2.9.1"
  },
  "overrides": {
    "typed-rest-client@2.3.1": {
      "qs": "6.16.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaksymShostak/steam-community-bbcode.git"
  },
  "bugs": {
    "url": "https://github.com/MaksymShostak/steam-community-bbcode/issues"
  },
  "homepage": "https://github.com/MaksymShostak/steam-community-bbcode#readme"
}
