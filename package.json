{
  "name": "steam-community-bbcode",
  "version": "1.0.0-rc.1",
  "private": false,
  "description": "Steam Community BBCode package under qualification; no released converter API yet",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@12.0.2",
  "main": "./src/index.js",
  "bin": {
    "steam-community-bbcode": "src/cli.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "coverage.json",
    "docs/third-party-notices.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "cli": "node src/cli.js",
    "comparison:run": "node scripts/compare-alternatives.js",
    "sbom": "npm sbom --package-lock-only --offline --ignore-scripts --sbom-format=cyclonedx",
    "sbom:type-coverage": "npm --prefix tooling/type-coverage sbom --package-lock-only --offline --ignore-scripts --sbom-format=cyclonedx",
    "sbom:api-docs": "npm --prefix tooling/api-docs sbom --package-lock-only --offline --ignore-scripts --sbom-format=cyclonedx",
    "conformance:generate": "node scripts/generate-conformance-report.js",
    "conformance:check": "node scripts/generate-conformance-report.js --check",
    "docs:check": "node --test test/documentation.test.js",
    "docs:api": "npm --prefix tooling/api-docs run generate",
    "docs:api:check": "npm --prefix tooling/api-docs run check",
    "docs:format": "node scripts/runRepositoryPython.js tooling/prose/format_docs.py --write",
    "docs:format:check": "node scripts/runRepositoryPython.js tooling/prose/format_docs.py --check",
    "qualify:prose": "node scripts/runRepositoryPython.js -m unittest discover -s tooling/prose -p test_format_docs.py",
    "lint": "eslint src scripts test tooling/api-docs/*.js eslint.config.js --max-warnings 0",
    "qualify:github": "node scripts/qualify-github-rendering.js --live",
    "qualify:performance": "node --test test/performance/*.test.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 node --test test/*.test.js test/parser-qualification/*.test.js",
    "test:mutation:library": "stryker run stryker.config.json",
    "test:mutation:cli": "stryker run stryker.cli.config.json",
    "test:mutation": "npm run test:mutation:library && npm run test:mutation:cli",
    "typecheck": "tsc --project tsconfig.json && npm run typecheck:api-docs",
    "typecheck:api-docs": "tsc --project tooling/api-docs/tsconfig.json",
    "build:types": "tsc --project tsconfig.declarations.json",
    "clean:types": "node scripts/clean-generated-types.js",
    "build": "npm run spec:generate && npm run clean:types && npm run build:types",
    "types:check": "node scripts/verify-generated-types.js",
    "test:package": "node scripts/test-package-consumers.js",
    "release:pack": "node scripts/build-release-candidate.js",
    "release:lint-package": "publint --strict",
    "release:preflight": "node scripts/qualify-release.js",
    "release:publish-bootstrap": "node scripts/qualify-release.js --publish",
    "release:verify-registry": "node scripts/qualify-public-registry.js",
    "type-coverage": "npm --prefix tooling/type-coverage run check && npm --prefix tooling/type-coverage run check:api-docs",
    "check": "npm run format:check && npm run spec:check && npm run lint && npm run docs:api:check && npm run qualify:prose && npm run docs:format:check && npm run test:coverage && npm run qualify:performance && npm run conformance:check && npm run typecheck && npm run type-coverage && npm run types:check && npm run test:types && npm run test:package",
    "test:types": "tsc --project test/type-contracts/tsconfig.json",
    "qualify:parser": "node --test test/parser-qualification/*.test.js",
    "validate:spec": "node scripts/validate-specification.js",
    "spec:generate": "node scripts/generate-registry-modules.js",
    "spec:check": "node scripts/generate-registry-modules.js --check",
    "setup:development": "node scripts/setup-development.js",
    "setup:sdlc:dependencies": "node scripts/runRepositoryPython.js -m pip install --require-hashes --only-binary=:all: -r requirements-sdlc.txt",
    "setup:sdlc": "node scripts/runRepositoryPython.js scripts/set_up_sdlc.py",
    "setup:skills": "node scripts/runRepositoryPython.js scripts/set_up_agent_skills.py --agent codex --local-only",
    "setup:sdlc:github": "node scripts/runRepositoryPython.js scripts/bootstrap_github_sdlc.py",
    "sdlc": "node scripts/runRepositoryPython.js scripts/sdlc.py",
    "check:sdlc": "node scripts/runRepositoryPython.js scripts/set_up_sdlc.py --check",
    "test:sdlc": "node scripts/runRepositoryPython.js -m unittest discover -s tests/sdlc -v",
    "test:setup": "node scripts/runRepositoryPython.js -m unittest discover -s tests -p test_set_up_*.py"
  },
  "dependencies": {
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3",
    "chevrotain": "13.2.0",
    "linkify-it": "6.1.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm": "3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sigstore/rekor-types": "5.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/make-fetch-happen": "10.0.4",
    "@types/node": "26.5.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "c8": "12.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "sigstore": "5.0.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "typed-rest-client@2.3.1": {
      "qs": "6.16.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaksymShostak/steam-community-bbcode.git"
  },
  "bugs": {
    "url": "https://github.com/MaksymShostak/steam-community-bbcode/issues"
  },
  "homepage": "https://github.com/MaksymShostak/steam-community-bbcode#readme"
}
